# server/.env olarak kopyala ve doldur. server/.env repoya GİRMEZ (.gitignore).
# Erişim kodları: virgülle ayrılmış, her biri en az 16 karakter. Üret: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ACCESS_CODES=
# Mapbox erişim anahtarı (Directions ve Search kapsamlı). Boş bırakılırsa Mapbox kapalı.
MAPBOX_TOKEN=
# OpenChargeMap API anahtarı. Boş bırakılırsa OpenChargeMap kapalı.
OCM_KEY=
# Dinlenen adres ve port. Cloudflare Tunnel kullanıyorsan 127.0.0.1 bırak.
HOST=127.0.0.1
PORT=8787
# Tünel (cloudflared) arkasındaysan 1: gerçek istemci adresi için CF-Connecting-IP okunur (istek sınırı ve yanlış kod engeli adrese göre çalışır).
TRUST_PROXY=1
# Tarayıcı/uygulama kökenleri (virgülle). Varsayılan: GitHub Pages sitesi ve Capacitor/yerel uygulama.
# ALLOW_ORIGINS=https://ozdemirumit.github.io,https://localhost,capacitor://localhost,http://localhost
# Mapbox aylık arama sınırı (ücretsiz katman ~5000); dolunca uygulama istasyonları Overpass/OpenChargeMap'ten alır. Ay başı sayacı için MAPBOX_MONTH_USED_SEED=YYYY-AA:sayı
# MAPBOX_MONTHLY_CAP=4800
# MAPBOX_MONTH_USED_SEED=2026-11:4899
# Adres başına dakikada istek sınırı
# RATE_PER_MIN=600

# ---- Hesaplar (davet + Google ile giriş) ----
# Sunucunun dışarıdan görünen adresi (Google dönüş adresi ve davet linkleri için): https://evcopilot.duckdns.org
PUBLIC_URL=
# Google Cloud Console > API'ler ve Hizmetler > Kimlik bilgileri > OAuth istemci kimliği (Web uygulaması).
# Yetkili yönlendirme URI'si: PUBLIC_URL + /auth/google/callback  Gizli anahtar yalnızca burada durur, repoya girmez.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Davetsiz kayıt olabilen ve yönetici olan e-postalar (virgülle). İlk girişi sen yaparsın.
ADMIN_EMAILS=
# Davet sayfasındaki "Web uygulamasında aç" adresi
# APP_URL=https://ozdemirumit.github.io/ev-copilot/
# ---- İstasyon doluluğu ve canlı fiyat ----
# Hollanda'da NDW/DOT-NL açık verisi anahtarsız çalışır (OCPI Locations + Tariffs). Diğer yerler için isteğe bağlı Google Places (Yeni) anahtarı:
# yalnızca burada durur. Anahtarı Google Cloud'da kısıtla: API = Places API (New), uygulama = IP adresi (sunucunun genel adresi), bütçe uyarısı kur.
GOOGLE_PLACES_KEY=
# Her Google çağrısı ücretlidir (Nearby Search: yaklaşık 32-40 USD / 1000 çağrı; ayda 1000-5000 çağrı ücretsiz, SKU'ya göre). Üst sınırlar:
# Google yalnızca pil bu yüzdenin altındayken sorulur (varsayılan 25). Üstüne, Google'ın EV verisi vermediği bölge (≈ 11 km) 7 gün atlanır;
# Türkiye'de ölçüldü: Google istasyonları listeliyor ama soket/doluluk vermiyor.
# GOOGLE_SOC_BELOW=25
# GOOGLE_DAILY_PER_USER=40
# GOOGLE_DAILY_TOTAL=150
# SMTP_USER=senin@gmail.com        # davet e-postasi icin (yonetim paneli); SMTP_PASS = Google UYGULAMA sifresi (normal sifre degil)
# SMTP_PASS=
# GOOGLE_COST_PER_CALL_USD=0.04   # yonetim panelindeki tahmini Google maliyeti icin cagri basina fiyat
# OCCUPANCY_DAILY_PER_USER=600
# Kullanıcı başına günlük kotalar (Mapbox faturasını korur)
# MAPBOX_DAILY_PER_USER=400
# OCM_DAILY_PER_USER=200
# OVERPASS_DAILY_PER_USER=300
# Oturum süresi (gün) ve veri klasörü
# SESSION_DAYS=180
# DATA_DIR=

# ---- HERE (istasyon listesi/doluluk ve Premium yol hız limiti) ----
# HERE platform API anahtarı: yalnızca burada durur, uygulamaya gitmez. Anahtarın projesinde Search (Browse) ve Routing v8 (router.hereapi.com) izinli olmalı.
HERE_API_KEY=
# HERE aylık istek tavanı: istasyon araması (/here/stations), doluluk ve yol hız limiti (/v1/speedlimits) AYNI sayacı paylaşır; dolunca 402 here_cap.
# HERE_MONTHLY_CAP=20000
# HERE_DAILY_PER_USER=800
# Premium yol hız limiti: kullanıcı başına günlük HERE rota isteği (navigasyon başına 1, yeniden rota başına 1; önbellekten dönen sayılmaz, yönetici muaf)
# SPEEDLIMIT_DAILY_PER_USER=40

# ---- Harita sağlayıcısı (Premium: Mapbox / Google Maps; herkes için OpenFreeMap anahtarsız) ----
# Bu iki anahtar TARAYICIYA gider (yalnızca Premium kullanıcıya, yalnızca seçili sağlayıcınınki, /v1/map/config ile); yukarıdaki sunucu içi MAPBOX_TOKEN / GOOGLE_PLACES_KEY'den AYRI anahtarlar kullan.
# Boş bırakılırsa o sağlayıcı kapalıdır ve uygulama bugünkü gibi OpenFreeMap ile çalışır.
# Mapbox: yalnızca herkese açık "pk." belirteci (gizli "sk." belirteci kabul EDİLMEZ, yok sayılır). Mapbox hesabında URL kısıtı koy: https://ozdemirumit.github.io/*
MAPBOX_MAP_TOKEN=
# Google: Maps JavaScript API anahtarı (HTTP yönlendiren kısıtı: https://ozdemirumit.github.io/*, API kısıtı: Maps JavaScript API).
# ÖNEMLİ: adres kısıtlarını anahtarın sahibi (sen) Mapbox/Google panelinde yapmalısın; sunucu bunu yapamaz. Kısıtsız anahtar çalınıp başkasının sitesinde kullanılabilir.
# Google Cloud'da Maps JavaScript API için GÜNLÜK KOTA SINIRI koy (Kotalar > günlük istek üst sınırı) ve bütçe uyarısı kur: fatura üst sınırı.
GOOGLE_MAPS_BROWSER_KEY=
# İsteğe bağlı: Google bulut tabanlı harita stili kimliği (boşsa DEMO_MAP_ID)
# Kendi kimliğini oluşturursan (Google Maps Platform > Map Management) tür "JavaScript", harita türü "Vector" seç ve "Tilt and rotation" seçeneklerini AÇ: navigasyonda 3B (eğim) bunlarsız çalışmaz.
# GOOGLE_MAP_ID=
# Anahtar veren çağrılar için günlük haklar (yalnızca anahtar dönen /v1/map/config çağrıları sayılır; OpenFreeMap sayılmaz):
# MAP_DAILY_PER_USER=100
# MAP_DAILY_TOTAL=3000
